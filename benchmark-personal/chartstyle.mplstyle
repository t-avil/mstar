figure.figsize: 7.0, 4.0
figure.dpi: 140
savefig.dpi: 140
savefig.bbox: tight
font.family: DejaVu Sans
font.size: 11
axes.titlesize: 13
axes.labelsize: 11
axes.grid: True
grid.alpha: 0.3
grid.linewidth: 0.6
legend.fontsize: 10
legend.frameon: False
xtick.labelsize: 10
ytick.labelsize: 10
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['4C72B0', 'DD8452', '55A868', 'C44E52'])
